        <file alias="sounds/key3.wav">../sounds/key3.wav</file>
        <file alias="sounds/key4.wav">../sounds/key4.wav</file>
        <file alias="sounds/space.wav">../sounds/space.wav</file>
        <file alias="sounds/backspace.wav">../sounds/backspace.wav</file>
        <file alias="sounds/return.wav">../sounds/return.wav</file>
